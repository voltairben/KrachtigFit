# Copy to .env.local and fill in. Never commit .env.local.

# Public site origin, no trailing slash. Used for canonical URLs, hreflang and sitemap.
NEXT_PUBLIC_SITE_URL="https://krachtigfit.nl"

# Resend — must use the EU region for AVG/GDPR data residency.
# https://resend.com/settings  ->  create key, set region to eu-west-1
RESEND_API_KEY=""
# Verified sending domain. Address that wizard submissions are sent FROM.
CONTACT_FROM_EMAIL="website@krachtigfit.nl"
# Where wizard submissions land.
CONTACT_TO_EMAIL="sander@krachtigfit.nl"

# Cloudflare Turnstile — privacy-preserving bot protection (no cookies, unlike reCAPTCHA).
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
